{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "postman-client",
  "version": "0.1.0",
  "identifier": "com.hamada.postmanclient",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "postman-client",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "shortDescription": "Lightweight, local-first API client with offline storage and AI assistance",
    "longDescription": "A blazingly fast, modern desktop API client built with Rust, Tauri 2, and SvelteKit. Featuring local SQLite persistence, sandboxed JavaScript tests, Postman v2.1 import/export, OpenAPI source discovery, and local AI capabilities.",
    "category": "Development",
    "copyright": "2026 Mohamed Hammada",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libssl3", "libayatana-appindicator3-1"]
      }
    }
  }
}
